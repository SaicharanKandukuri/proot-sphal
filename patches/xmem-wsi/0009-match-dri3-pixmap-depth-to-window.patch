From: uDroid graphics runtime
Subject: [PATCH] X11 WSI: match DRI3 pixmap depth to the target window

DRI3 Present requires the source pixmap depth to match the destination
window.  Using depth 24 unconditionally makes alpha-capable depth-32 clients,
including Alacritty, present transparent or fail with BadMatch.  Read the
target window geometry once during swapchain initialization, accept the two
32-bpp depths supported by this AHardwareBuffer path, and create each pixmap
with the negotiated depth.
---
diff --git a/wsi/x11/swapchain.cpp b/wsi/x11/swapchain.cpp
--- a/wsi/x11/swapchain.cpp
+++ b/wsi/x11/swapchain.cpp
@@ -185,6 +185,7 @@ swapchain::swapchain(layer::device_private_data &dev_data, const VkAllocationCal
    , m_send_sbc(0)
    , m_target_msc(0)
    , m_last_present_msc(0)
+   , m_window_depth(0)
    , m_ahb_image_format(VK_FORMAT_UNDEFINED)
    , m_ahb_dri3_modifier(0)
    , m_explicit_sync_enabled(false)
@@ -272,7 +273,8 @@ xcb_pixmap_t swapchain::create_pixmap(swapchain_image &image)
    auto pixmap = xcb_generate_id(m_connection);
    auto cookie = xcb_dri3_pixmap_from_buffers_checked(
       m_connection, pixmap, m_window, 1, m_image_create_info.extent.width, m_image_create_info.extent.height,
-      data->layout.rowPitch, data->layout.offset, 0, 0, 0, 0, 0, 0, 24, 32, m_ahb_dri3_modifier, &fds[1]);
+      data->layout.rowPitch, data->layout.offset, 0, 0, 0, 0, 0, 0, m_window_depth, 32,
+      m_ahb_dri3_modifier, &fds[1]);
    xcb_flush(m_connection);
 
    bool transport_ok = false;
@@ -775,6 +777,17 @@ VkResult swapchain::init_platform(VkDevice device, const VkSwapchainCreateInfoKHR
       return VK_ERROR_INITIALIZATION_FAILED;
    }
 
+   uint32_t window_width = 0;
+   uint32_t window_height = 0;
+   int window_depth = 0;
+   if (!m_surface->get_size_and_depth(&window_width, &window_height, &window_depth) ||
+       (window_depth != 24 && window_depth != 32))
+   {
+      WSI_LOG_ERROR("Unsupported X11 window depth %d", window_depth);
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+   }
+   m_window_depth = static_cast<uint8_t>(window_depth);
+
    buffer_transport_protocol protocol{};
    const char *protocol_mode = getenv("UDROID_X11_PROTOCOL");
    const bool legacy_protocol = protocol_mode != nullptr && strcmp(protocol_mode, "legacy") == 0;
diff --git a/wsi/x11/swapchain.hpp b/wsi/x11/swapchain.hpp
--- a/wsi/x11/swapchain.hpp
+++ b/wsi/x11/swapchain.hpp
@@ -173,6 +173,7 @@ private:
    uint64_t m_send_sbc;
    uint64_t m_target_msc;
    uint64_t m_last_present_msc;
+   uint8_t m_window_depth;
    VkFormat m_ahb_image_format;
    uint64_t m_ahb_dri3_modifier;
    bool m_explicit_sync_enabled;
